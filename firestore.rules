rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins are identified by their authenticated email (server-enforced,
    // not just the client-side ADMIN_EMAILS check in the app).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['kdy20330@gmail.com', 'ykandoi20330@gmail.com'];
    }

    // The signed-in user owns this document.
    function isOwner() {
      return request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /plots/{plotId} {
      // Listings are public to read.
      allow read: if true;

      // New listings must start as 'Verification Pending'. Only an admin can
      // create a listing in any other state — this stops a malicious user from
      // self-publishing a plot pre-marked 'Verified'.
      allow create: if isAdmin()
        || (request.auth != null && request.resource.data.status == 'Verification Pending');

      // Owners may edit their own listing but CANNOT change its verification
      // status. Only an admin can verify/reject or edit any listing.
      allow update: if isAdmin()
        || (isOwner() && request.resource.data.status == resource.data.status);

      // Only an admin or the listing's owner can delete it.
      allow delete: if isAdmin() || isOwner();
    }

    // Each user can only read/write their own saved interests.
    match /interests/{userId}/plots/{plotId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // A broker profile is APPROVED by an admin. Used to gate buyer-PII access.
    function isApprovedBroker() {
      return request.auth != null
        && exists(/databases/$(database)/documents/brokers/$(request.auth.uid))
        && get(/databases/$(database)/documents/brokers/$(request.auth.uid)).data.status == 'approved';
    }

    // Broker profiles live at brokers/{uid}. A profile does NOT by itself grant
    // access to buyer data — an admin must set status to 'approved' first.
    match /brokers/{brokerUid} {
      // A broker's phone/email is PII. Registering no longer requires a real
      // account (anonymous sessions are handed out freely to guest listers), so
      // "any signed-in user" is no longer a meaningful bar — narrowed to the
      // admin and the broker themselves, which is all the app actually reads.
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == brokerUid);

      // A user may create their OWN profile, but it MUST start 'pending' — they
      // cannot self-approve.
      allow create: if request.auth != null
        && request.auth.uid == brokerUid
        && request.resource.data.status == 'pending';

      // The owner may edit their own profile but CANNOT change their approval
      // status. Only an admin can approve/reject (change status).
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == brokerUid
            && request.resource.data.status == resource.data.status);

      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == brokerUid);
    }

    // Broker-built property catalogs (see src/hooks/useCatalogs.js). A catalog
    // is a hand-picked set of listings a broker shares with one client.
    match /catalogs/{catalogId} {
      // World-readable BY DESIGN: the whole point is a link a broker can send
      // to a client who has no account. Secrecy rests on the doc ID being an
      // unguessable 20-char Firestore auto-ID, not on auth. Brokers are warned
      // in the UI not to put anything confidential in a catalog.
      allow read: if true;

      // Only a signed-in principal can create one, and only under their own
      // uid — so a catalog can never be attributed to another broker.
      allow create: if request.auth != null
        && request.resource.data.brokerUid == request.auth.uid;

      // Only the owning broker (or an admin) may edit or remove it, and
      // ownership itself can't be reassigned on update.
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.brokerUid == request.auth.uid
            && request.resource.data.brokerUid == resource.data.brokerUid);

      allow delete: if isAdmin()
        || (request.auth != null && resource.data.brokerUid == request.auth.uid);
    }

    // Signed-in user directory (see src/hooks/useUsers.js). The client SDK
    // can't enumerate Firebase Auth accounts, so each user mirrors their own
    // profile here on sign-in and the admin panel reads the collection.
    match /users/{userId} {
      // Only an admin can see the whole directory; a user can read their own
      // record. Nobody else can read anyone's email/photo.
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);

      // A user may only ever write their OWN document, and only the profile
      // fields the mirror actually needs — this stops someone from parking
      // arbitrary data (or a fake 'role') under their uid.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
             'uid', 'email', 'displayName', 'photoURL',
             'providers', 'lastSeenAt', 'signInCount', 'createdAt'
           ]);

      allow delete: if isAdmin();
    }

    // Buyer requirements (open "I want to buy X in city Y" posts).
    match /requirements/{reqId} {
      // Buyer PII is only readable by admins, ADMIN-APPROVED brokers, or the
      // buyer who posted it. A self-registered (pending) broker gets nothing.
      allow read: if isAdmin()
        || isApprovedBroker()
        || (request.auth != null && resource.data.buyerUid == request.auth.uid);

      // A signed-in user may only post a requirement under their own uid, and it
      // must start 'open'.
      allow create: if request.auth != null
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.status == 'open';

      // Only the buyer who owns it (or an admin) can edit/close/delete it.
      allow update, delete: if isAdmin()
        || (request.auth != null && resource.data.buyerUid == request.auth.uid);
    }
  }
}
